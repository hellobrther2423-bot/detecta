# ── DETECTOMA backend configuration ──────────────────────────────────────────
# Copy to .env and adjust. Every value below has a safe local-dev default in
# code, so the app runs even with an empty .env.

# App
APP_NAME=DETECTOMA
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security — CHANGE THESE for anything other than local dev.
# SECRET_KEY signs JWTs. STORAGE_ENCRYPTION_KEY encrypts uploaded files at rest.
# Generate a Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=dev-insecure-change-me
STORAGE_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite for local dev (default). For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/detectoma
DATABASE_URL=sqlite:///./detectoma.db

# File storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# OCR provider: auto | mock | google | azure
#   auto  -> use google/azure if keys present, else mock
OCR_PROVIDER=auto
GOOGLE_VISION_CREDENTIALS_JSON=
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Email provider: auto | console | smtp
EMAIL_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@detectoma.app
